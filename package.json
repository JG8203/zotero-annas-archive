{
  "name": "zotero-annas-archive",
  "version": "3.0.1",
  "description": "Download PDFs for Zotero items by DOI from Anna's Archive SciDB",
  "type": "module",
  "config": {
    "addonName": "Anna's Archive for Zotero",
    "addonID": "zotero-annas-archive@jg8203.github.io",
    "addonRef": "annasarchive",
    "addonInstance": "AnnasArchive",
    "prefsPrefix": "extensions.zotero.annasarchive"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janbaykara/zotero-annas-archive.git"
  },
  "author": "JG8203",
  "bugs": {
    "url": "https://github.com/janbaykara/zotero-annas-archive/issues"
  },
  "homepage": "https://github.com/janbaykara/zotero-annas-archive#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
