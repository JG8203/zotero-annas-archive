# Usage:
# Copy this file as `.env` and fill in the variables below.

# Path to the Zotero binary.
# macOS: */Zotero.app/Contents/MacOS/zotero
# Windows: escape backslashes as \\
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero

# Shared RDP port for MCP Bridge (Zotero plugin) and Cursor's MCP server.
# Point Cursor mcp.json at scripts/mcp-zotero-dev.mjs so it reads this value.
# Requires MCP Bridge for Zotero: https://github.com/introfini/mcp-server-zotero-dev/releases
ZOTERO_RDP_PORT=6100

# Optional: profile used for development.
# Start the profile manager with: $ZOTERO_PLUGIN_ZOTERO_BIN_PATH -p
# @see https://www.zotero.org/support/kb/profile_directory
# ZOTERO_PLUGIN_PROFILE_PATH=

# Optional: data directory (empty = default)
# @see https://www.zotero.org/support/zotero_data
# ZOTERO_PLUGIN_DATA_DIR=
